# What the system shows when a web page asks for a device feature (Day.toml [permissions]).
permission_camera = Net Skip को आपके कैमरे तक पहुँच की आवश्यकता है ताकि जिन वेबसाइटों पर आप जाते हैं वे आपकी अनुमति देने पर वीडियो कॉल, QR कोड स्कैन और फ़ोटो खींचने के लिए इसका उपयोग कर सकें।
permission_microphone = Net Skip को आपके माइक्रोफ़ोन तक पहुँच की आवश्यकता है ताकि जिन वेबसाइटों पर आप जाते हैं वे आपकी अनुमति देने पर इसका उपयोग वॉइस और वीडियो कॉल, वॉइस सर्च और ऑडियो रिकॉर्डिंग के लिए कर सकें।
permission_location_when_in_use = Net Skip आपके स्थान का उपयोग उन वेबसाइटों को स्थान-आधारित सुविधाएँ प्रदान करने के लिए करता है जिन पर आप जाते हैं, जैसे आपकी अनुमति देने पर मानचित्र, स्थानीय खोज परिणाम और मौसम की जानकारी।
permission_motion = Net Skip गति और दिशा डेटा का उपयोग करता है ताकि जिन वेबसाइटों पर आप जाते हैं वे आपकी अनुमति देने पर आपके डिवाइस को हिलाने और झुकाने के तरीके पर प्रतिक्रिया देने वाले इंटरैक्टिव अनुभव प्रदान कर सकें।
permission_NSSpeechRecognitionUsageDescription = Net Skip स्पीच रिकग्निशन का उपयोग करता है ताकि आप टाइप करने के बजाय आवाज़ से URL, खोज प्रश्न और फ़ॉर्म इनपुट बोलकर दर्ज कर सकें।
